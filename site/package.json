{
  "name": "dsa-demystified-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "prepare:content": "python3 scripts/generate-catalog.py && node scripts/publish-assets.mjs",
    "build": "npm run prepare:content && next build",
    "predev": "npm run prepare:content",
    "pretypecheck": "python3 scripts/generate-catalog.py",
    "precheck:content": "python3 scripts/generate-catalog.py",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components lib content scripts *.ts *.json *.mjs README.md",
    "check:content": "node scripts/check-content.mjs",
    "check:links": "python3 scripts/check-export.py",
    "preview": "python3 -m http.server 3000 --bind 127.0.0.1 --directory out"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "mermaid": "12.2.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-parse": "9.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
